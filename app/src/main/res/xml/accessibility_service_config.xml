<?xml version="1.0" encoding="utf-8"?>
<!--
  Configures SentinelAccessibilityService as a *passive* window-change observer.
  We deliberately request the minimum capabilities required to read the foreground
  package name; no event payload, view tree or text scraping is collected.
-->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagDefault|flagRetrieveInteractiveWindows"
    android:canRetrieveWindowContent="false"
    android:description="@string/accessibility_service_description"
    android:notificationTimeout="100"
    android:settingsActivity="com.sentinelvault.MainActivity" />
