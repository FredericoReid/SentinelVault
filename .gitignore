# Built application files
*.apk
*.aar
*.ap_
*.aab

# Files for the ART/Dalvik VM
*.dex

# Java class files
*.class

# Generated files
bin/
gen/
out/
release/

# Gradle files
.gradle/
**/build/

# Local configuration file (sdk path, signing hash, etc) - matches at any depth
local.properties

# Proguard folder generated by Eclipse
proguard/

# Log Files
*.log
*.log.*

# Android Studio Navigation editor temp files
.navigation/

# Android Studio captures folder / Profiler artifacts
captures/
*.hprof
*.heapdump
*.trace

# IntelliJ
*.iml
.idea/
*.ipr
*.iws

# VS Code
.vscode/

# ---------------------------------------------------------------------------
# Signing material - NEVER commit anything that could re-sign the APK.
# IntegrityManager pins the SHA-256 of the production certificate, so leaking
# any of these would let an attacker ship a tampered build that bypasses it.
# ---------------------------------------------------------------------------
*.jks
*.keystore
*.p12
*.pfx
*.pem
*.key
keystore.properties
signing.properties
key.properties

# Environment files - may carry secrets even though the app is offline.
.env
.env.*
!.env.example

# External native build folder generated in Android Studio 2.2 and later
.externalNativeBuild
.cxx/

# Google Services (e.g. APIs or Firebase) - not used (Zero-Internet Policy)
google-services.json

# Version control
vcs.xml

# lint
lint/intermediates/
lint/generated/
lint/outputs/
lint/tmp/

# OS
.DS_Store
Thumbs.db
desktop.ini

# Kotlin
.kotlin/

# ---------------------------------------------------------------------------
# Sensitive runtime artefacts. The app encrypts everything at rest, but a
# developer pulling the encrypted DB or extracted vault assets to disk for
# debugging must never let them slip into a commit.
# ---------------------------------------------------------------------------
*.db
*.db-journal
*.db-shm
*.db-wal
*.sqlite
*.sqlite-journal
/vault/
/incidents/
/enrollment/

# Coverage / test reports
coverage/
jacoco.exec
*.exec

# Editor / scratch
*.bak
*.swp
*.swo
*~
